# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# pnpm 11 auto-generates pnpm-workspace.yaml to track build-script approvals.
# We don't have a workspace; the equivalent config lives in package.json
# under `pnpm.onlyBuiltDependencies`. Ignore the auto-generated file so it
# never reaches the Docker build (where pnpm 9 chokes on its non-standard
# `allowBuilds` syntax).
pnpm-workspace.yaml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docs/images/from_owner

# Playwright verification artifacts (screenshots, console logs)
/.playwright-mcp/
/rail-*.png
/candle-*.png
