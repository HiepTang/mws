# MWS production environment.
# On the VPS this lives at ~/apps/mws/.env (chmod 600). Never commit the real .env.
#
# Phase 1 only needs the first two blocks. Drizzle/Auth/Resend/Turnstile
# variables come online in later phases; left here as a forward reference.

# ─── Phase 0 secrets (filled in from runbook) ─────────────────────────
DATABASE_URL=postgres://mws:CHANGEME_MWS_PG_PASSWORD@postgres:5432/mws

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mws-uploads
S3_ACCESS_KEY=CHANGEME_MWS_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGEME_MWS_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true

# ─── Docker network name (resolved by docker-compose.prod.yml) ────────
# Run `docker network ls | grep khoai-network` on the VPS and paste the result.
KHOAI_NETWORK_NAME=infrastructure_khoai-network

# ─── Public URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mws.kho-ai.com

# ─── Phase 2: Auth.js (filled in later) ───────────────────────────────
# AUTH_SECRET=                  # openssl rand -base64 32
# AUTH_URL=https://mws.kho-ai.com
# ALLOWED_ADMIN_EMAILS=juliane@example.com

# ─── Phase 4/5: Email (Resend) ────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@mississaugaweddsols.com
# EMAIL_TO_OWNER=

# ─── Phase 4/5: Spam protection (Cloudflare Turnstile) ────────────────
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
