# MWS production environment.
# On the VPS this lives at ~/apps/mws/.env (chmod 600). Never commit the real .env.
#
# Phase 1 only needs the first two blocks. Drizzle/Auth/Resend/Turnstile
# variables come online in later phases; left here as a forward reference.

# ─── Phase 0 secrets (filled in from runbook) ─────────────────────────
DATABASE_URL=postgres://mws:CHANGEME_MWS_PG_PASSWORD@postgres:5432/mws

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mws-uploads
S3_ACCESS_KEY=CHANGEME_MWS_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGEME_MWS_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true

# ─── Docker network name (resolved by docker-compose.prod.yml) ────────
# Run `docker network ls | grep khoai-network` on the VPS and paste the result.
KHOAI_NETWORK_NAME=infrastructure_khoai-network

# ─── Public URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mws.kho-ai.com

# ─── Phase 2: Auth.js ─────────────────────────────────────────────────
AUTH_SECRET=CHANGEME_openssl_rand_base64_32   # `openssl rand -base64 32`
AUTH_URL=https://mws.kho-ai.com               # public origin Auth.js advertises
AUTH_TRUST_HOST=true                          # required behind Caddy / Cloudflare
ALLOWED_ADMIN_EMAILS=juliane@example.com      # comma-separated allowlist

# ─── Phase 2: Email (Resend) for magic-link sign-in ──────────────────
RESEND_API_KEY=re_CHANGEME
EMAIL_FROM=no-reply@kho-ai.com                # preview phase; switch to mississaugaweddsols.com at launch
EMAIL_TO_OWNER=                               # owner notifications. Accepts comma-separated list, e.g. juliane.cao@rogers.com,tpthiep@gmail.com

# ─── Phase 5: Spam protection (Cloudflare Turnstile) ──────────────────
# Site key is exposed to the browser (NEXT_PUBLIC_), secret key is server-only.
# When both are unset, the contact form skips verification — handy for local dev
# but a warning prints in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
